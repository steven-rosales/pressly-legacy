{
  "extends": "../../tooling/typescript/node.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "rootDir": "../..",
    "types": ["node", "vitest"],
    "paths": {
      "@pressly/cells": ["../../platform/cells/src/public.ts"],
      "@pressly/codec": ["../../platform/codec/src/index.ts"],
      "@pressly/errors/*": ["../../platform/errors/src/*.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts"],
  "exclude": ["dist", "node_modules"],
  "references": [
    {
      "path": "../../topology/tsconfig.build.json"
    },
    {
      "path": "../../platform/cells/tsconfig.json"
    },
    {
      "path": "../../platform/config/tsconfig.json"
    },
    {
      "path": "../../platform/errors/tsconfig.json"
    },
    {
      "path": "../../platform/http/tsconfig.json"
    },
    {
      "path": "../../platform/logging/tsconfig.json"
    },
    {
      "path": "../../platform/observability/tsconfig.json"
    },
    {
      "path": "../../platform/postgres/tsconfig.json"
    },
    {
      "path": "../../platform/time/tsconfig.json"
    }
  ]
}

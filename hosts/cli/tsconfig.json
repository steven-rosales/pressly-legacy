      "path": "../../generated/runtime/tsconfig.json"
    },
    {
      "path": "../../platform/cells/tsconfig.json"
    },
    {
      "path": "../../platform/errors/tsconfig.json"
    },
    {
      "path": "../../platform/http/tsconfig.json"
    },
    {
      "path": "../../platform/postgres/tsconfig.json"
    },
    {
      "path": "../../platform/time/tsconfig.json"
    }
  ]
}

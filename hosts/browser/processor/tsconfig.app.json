{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "references": [
    {
      "path": "../../../experiences/processor/tsconfig.json"
    },
    {
      "path": "../../../generated/runtime/tsconfig.json"
    },
    {
      "path": "../../../generated/tsconfig.json"
    },
    {
      "path": "../../../platform/codec/tsconfig.json"
    },
    {
      "path": "../../../platform/errors/tsconfig.json"
    },
    {
      "path": "../../../platform/http/tsconfig.json"
    }
  ]
}

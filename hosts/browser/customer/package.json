{
  "name": "@pressly/customer-browser-host",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:workspace-deps": "pnpm --dir ../../.. exec turbo build --filter='@pressly/customer-browser-host^...' --concurrency=2",
    "dev": "pnpm run build:workspace-deps && next dev",
    "build": "pnpm run build:workspace-deps && next build",
    "typecheck": "tsc --noEmit",
    "seo:validate": "node scripts/validate-seo.mjs",
    "schema:validate": "node scripts/validate-schema.mjs",
    "lint": "eslint . --max-warnings=0",
    "test": "VITEST_MAX_WORKERS=2 vitest run",
    "test:watch": "VITEST_MAX_WORKERS=2 vitest",
    "test:coverage": "VITEST_MAX_WORKERS=2 vitest run --coverage",
    "clean": "rm -rf .next"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@pressly/cells": "workspace:*",
    "@pressly/config": "workspace:*",
    "@pressly/errors": "workspace:*",
    "@pressly/http": "workspace:*",
    "@pressly/logging": "workspace:*",
    "@pressly/observability": "workspace:*",
    "@pressly/time": "workspace:*",
    "@pressly/topology": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@sentry/nextjs": "^10.69.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.11.0",
    "next": "^16.3.0",
    "posthog-js": "^1.414.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.73.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  }
}

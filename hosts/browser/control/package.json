{
  "name": "@pressly/control-browser-host",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.lib.json && tsc -b tsconfig.app.json tsconfig.node.json && vite build",
    "clean": "rm -rf dist",
    "dev": "vite",
    "lint": "eslint . --max-warnings=0",
    "preview": "vite preview",
    "test": "VITEST_MAX_WORKERS=2 vitest run",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit && tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@pressly/errors": "workspace:*",
    "@pressly/generated-runtime": "workspace:*",
    "@pressly/http": "workspace:*",
    "@sentry/react": "^10.69.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shadcn": "^4.16.2",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@pressly/experience-control": "workspace:*",
    "@sentry/vite-plugin": "5.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  }
}

{
  "name": "@pressly/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./authentication": {
      "types": "./dist/authentication/index.d.ts",
      "import": "./dist/authentication/index.js",
      "default": "./dist/authentication/index.js"
    },
    "./authorization": {
      "types": "./dist/authorization/index.d.ts",
      "import": "./dist/authorization/index.js",
      "default": "./dist/authorization/index.js"
    },
    "./credentials": {
      "types": "./dist/credentials/index.d.ts",
      "import": "./dist/credentials/index.js",
      "default": "./dist/credentials/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test --no-error-on-unmatched-pattern --max-warnings=0",
    "test": "vitest run --dir test",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@pressly/errors": "workspace:*",
    "@pressly/kernel": "workspace:*",
    "argon2": "^0.44.0"
  },
  "devDependencies": {
    "@pressly/tsconfig": "workspace:*",
    "typescript": "latest",
    "vitest": "^4.1.5"
  }
}

{
  "name": "@pressly/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json",
    "lint": "eslint src test --no-error-on-unmatched-pattern --max-warnings=0",
    "test": "vitest run --dir test --exclude '**/*.int.test.ts'",
    "test:integration": "vitest run --dir test --no-file-parallelism",
    "migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "generate": "drizzle-kit generate --config drizzle.config.ts",
    "seed:pricing": "tsx src/seeds/pricing.ts",
    "migrate:docker": "pnpm --dir ../.. docker:db:migrate",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.0",
    "pg": "^8.20.0",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@pressly/tsconfig": "workspace:*",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "^4.1.5"
  }
}

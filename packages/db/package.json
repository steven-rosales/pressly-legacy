{
  "name": "@pressly/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "tsx --test 'src/**/*.test.ts' 'src/**/*.spec.ts'",
    "migrate": "tsx src/migrate-cli.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@types/node": "^25.6.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.0",
    "pg": "^8.20.0",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@pressly/errors": "workspace:*",
    "@pressly/tsconfig": "workspace:*",
    "@pressly/pricing": "workspace:*",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "latest",
    "typescript": "latest"
  }
}

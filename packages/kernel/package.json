{
  "name": "@pressly/kernel",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test --no-error-on-unmatched-pattern --max-warnings=0",
    "test": "VITEST_MAX_WORKERS=2 vitest run --dir test",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@pressly/errors": "workspace:*"
  },
  "devDependencies": {
    "@pressly/tsconfig": "workspace:*",
    "@types/node": "^25.6.0",
    "typescript": "latest",
    "vitest": "^4.1.5"
  }
}

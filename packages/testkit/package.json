{
  "name": "@pressly/testkit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./database": {
      "types": "./dist/database.d.ts",
      "import": "./dist/database.js",
      "default": "./dist/database.js"
    },
    "./clock": {
      "types": "./dist/clock.d.ts",
      "import": "./dist/clock.js",
      "default": "./dist/clock.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js",
      "default": "./dist/http.js"
    },
    "./id-source": {
      "types": "./dist/id-source.d.ts",
      "import": "./dist/id-source.js",
      "default": "./dist/id-source.js"
    },
    "./result": {
      "types": "./dist/result.d.ts",
      "import": "./dist/result.js",
      "default": "./dist/result.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test --no-error-on-unmatched-pattern --max-warnings=0",
    "test": "VITEST_MAX_WORKERS=2 vitest run --passWithNoTests",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@pressly/db": "workspace:*",
    "@pressly/errors": "workspace:*",
    "@pressly/kernel": "workspace:*",
    "@pressly/time": "workspace:*"
  },
  "devDependencies": {
    "@pressly/tsconfig": "workspace:*",
    "typescript": "latest",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "vitest": "^4.1.10"
  }
}

{
  "name": "@pressly/http",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./express": {
      "types": "./dist/express/index.d.ts",
      "import": "./dist/express/index.js",
      "default": "./dist/express/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test --no-error-on-unmatched-pattern --max-warnings=0",
    "test": "vitest run --dir test",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@pressly/errors": "workspace:*",
    "@pressly/kernel": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@pressly/tsconfig": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.1",
    "express": "^5.2.1",
    "typescript": "latest",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "express": "^5.2.1"
  }
}

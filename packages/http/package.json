{
  "name": "@pressly/http",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./express": "./src/express/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",

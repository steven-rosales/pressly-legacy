    "test": "tsx --test 'test/**/*.test.ts' 'test/**/*.spec.ts'",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@pressly/tsconfig": "workspace:*",
    "tsx": "latest",
    "typescript": "latest"
  }

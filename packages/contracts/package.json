    "./webhook-ingestion": {
      "types": "./dist/webhook-ingestion/index.d.ts",
      "import": "./dist/webhook-ingestion/index.js",
      "default": "./dist/webhook-ingestion/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test --no-error-on-unmatched-pattern --max-warnings=0",
    "test": "VITEST_MAX_WORKERS=2 vitest run --passWithNoTests",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@pressly/codec": "workspace:*",
    "@pressly/time": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@pressly/tsconfig": "workspace:*",
    "typescript": "latest",
    "vitest": "^4.1.5"
  }

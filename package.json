{
  "name": "pressly",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "turbo dev --concurrency=2",
    "build": "turbo build --concurrency=2",
    "build:integration-deps": "turbo build --filter='@pressly/http-host...' --filter='@pressly/jobs-host...' --concurrency=2",
    "typecheck": "turbo typecheck --concurrency=2 && pnpm typecheck:browser && pnpm typecheck:postgres-tooling && pnpm typecheck:http-route-census",
    "typecheck:browser": "tsc -p tooling/browser-e2e/tsconfig.json --noEmit",
    "typecheck:postgres-tooling": "tsc -p tooling/postgres/tsconfig.json --noEmit",
    "typecheck:http-route-census": "tsc -p tooling/http-route-census/tsconfig.json --noEmit",
    "lint": "pnpm architecture:check && turbo lint --concurrency=2 && pnpm lint:browser && pnpm lint:postgres-tooling && pnpm lint:http-route-census && pnpm lint:type-aware && pnpm lint:architecture",
    "lint:browser": "eslint tooling/browser-e2e --max-warnings=0",
    "lint:postgres-tooling": "eslint tooling/postgres --max-warnings=0",
    "lint:http-route-census": "eslint tooling/http-route-census --max-warnings=0",
    "lint:type-aware": "node tooling/scripts/run-type-aware-lint.mjs",
    "lint:architecture": "pnpm lint:architecture:cellular",
    "lint:architecture:cellular": "pnpm typescript:references:check && node tooling/scripts/generate-dependency-cruiser-tsconfig.mjs --check && eslint hosts systems experiences platform topology generated verification --no-error-on-unmatched-pattern --max-warnings=0",
    "architecture:check": "pnpm architecture:residue && pnpm architecture:cellular && pnpm architecture:topology",
    "architecture:residue": "node tooling/scripts/audit-final-residue.mjs",
    "architecture:residue:outputs": "node tooling/scripts/audit-final-residue.mjs --include-outputs",
    "architecture:cellular:build": "turbo build --filter='./platform/*' --filter='./systems/*' --filter='./experiences/*' --filter='./hosts/*' --filter='./hosts/browser/*' --filter='./topology' --filter='./generated' --concurrency=2",
    "architecture:cellular": "pnpm typescript:references:check && pnpm architecture:cellular:build && node tooling/scripts/generate-dependency-cruiser-tsconfig.mjs --check && depcruise --config dependency-cruiser.config.mjs hosts systems experiences platform topology generated verification",
    "architecture:topology": "pnpm --filter @pressly/topology test && pnpm --filter @pressly/topology-verification test && pnpm architecture:rules:test && pnpm architecture:generated:check",
    "architecture:rules:test": "VITEST_MAX_WORKERS=2 vitest run tooling/test/cellular-architecture-enforcement.test.mjs tooling/test/architecture-lint.test.mjs",
    "architecture:generate": "pnpm typescript:references:write && node tooling/scripts/generate-dependency-cruiser-tsconfig.mjs && pnpm --filter @pressly/topology generate",
    "architecture:generated:check": "pnpm --filter @pressly/topology check:generated",
    "architecture:explain": "pnpm --filter @pressly/topology explain --",
    "typescript:references:check": "node tooling/scripts/sync-typescript-project-references.mjs",
    "typescript:references:write": "node tooling/scripts/sync-typescript-project-references.mjs --write",
    "test:cells": "pnpm --filter @pressly/cells test && pnpm -r --workspace-concurrency=2 --filter './systems/*' run test",
    "test:systems:int": "bash tooling/scripts/run-integration-tests.sh systems",
    "test:topology": "pnpm --filter @pressly/topology test",
    "test:conformance": "bash tooling/scripts/run-integration-tests.sh conformance",
    "verify:refactor": "pnpm architecture:check && pnpm typecheck && pnpm test:cells && pnpm test:systems:int && pnpm test:topology && pnpm test:conformance && pnpm test:browser:smoke",
    "test": "VITEST_MAX_WORKERS=2 turbo test --concurrency=2 && VITEST_MAX_WORKERS=2 vitest run tooling/test",
    "clean": "turbo clean --concurrency=2 && rm -rf stateworks/dist",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "docker:web:build": "node ./tooling/scripts/docker-stack.mjs build-web",
    "docker:web:run": "docker run --rm -p 3000:3000 pressly-web:local",
    "docker:web:up": "docker compose up --no-build web",
    "docker:web:down": "docker compose down --remove-orphans",
    "docker:postgres:up": "docker compose up -d postgres",
    "docker:postgres:logs": "docker compose logs -f postgres",
    "docker:postgres:shell": "docker compose exec postgres psql -U pressly -d pressly",
    "docker:test-db:up": "docker compose up -d --wait postgres-test",
    "docker:test-db:down": "docker compose stop postgres-test",
    "docker:test-db:logs": "docker compose logs -f postgres-test",
    "docker:test-db:shell": "docker compose exec postgres-test psql -U pressly -d pressly_test",
    "docker:api:build": "docker build --target dev -f deploy/images/api/Dockerfile -t pressly-api:local .",
    "docker:api:build:runner": "docker build --target runner -f deploy/images/api/Dockerfile -t pressly-api:local .",
    "docker:api:up": "docker compose up -d --build postgres api",
    "docker:api:logs": "docker compose logs -f api",
    "docker:api:shell": "docker compose exec api sh",
    "docker:db:migrate": "docker compose run --rm --build api sh -c \"pnpm install --frozen-lockfile && pnpm db:migrate\"",
    "docker:db:seed:pricing": "docker compose run --rm --build api sh -c \"pnpm install --frozen-lockfile && pnpm db:seed:pricing\"",
    "docker:db:setup": "docker compose run --rm --build api sh -c \"pnpm install --frozen-lockfile && pnpm db:migrate && pnpm db:seed:pricing\"",
    "docker:up": "node ./tooling/scripts/docker-stack.mjs up",
    "docker:logs": "docker compose logs -f --tail=200 postgres api web worker processor control",
    "docker:down": "docker compose down --remove-orphans",
    "env:web:pull": "pnpm dlx vercel env pull hosts/browser/customer/.env.local --environment=development --yes",
    "env:api:pull": "pnpm dlx vercel env pull hosts/http/.env.local --environment=development --yes",
    "env:cli:pull": "pnpm dlx vercel env pull hosts/cli/.env.local --environment=development --yes",
    "db:build:migration-deps": "turbo build --filter='@pressly/postgres...' --concurrency=2",
    "db:build:pricing-seed-deps": "turbo build --filter='@pressly/postgres...' --filter='@pressly/pricing-system...' --concurrency=2",
    "db:generate": "pnpm --filter @pressly/topology generate:migrations",
    "db:migrate": "pnpm db:build:migration-deps && tsx tooling/postgres/migrate.ts",
    "db:verify:restored": "pnpm db:build:migration-deps && tsx tooling/postgres/verify-restored-migration.ts",
    "db:seed:pricing": "pnpm db:build:pricing-seed-deps && tsx tooling/postgres/seed-pricing.ts",
    "db:setup": "pnpm db:migrate && pnpm db:seed:pricing",
    "auth:bootstrap:owner": "pnpm -F @pressly/cli-host bootstrap:owner --",
    "production:bootstrap": "pnpm -F @pressly/cli-host bootstrap:production --",
    "admin": "node ./tooling/scripts/run-admin-cli.mjs",
    "admin:docker": "node ./tooling/scripts/run-admin-cli.mjs --docker",
    "admin:env": "pnpm -F @pressly/cli-host dev --",
    "db:test:migrate": "DATABASE_URL=${PRESSLY_TEST_MIGRATION_DATABASE_URL:-postgres://pressly_migration:pressly_migration_test@localhost:55434/pressly_test} pnpm db:migrate",
    "test:auth:int": "bash tooling/scripts/run-integration-tests.sh auth",
    "test:pricing:int": "bash tooling/scripts/run-integration-tests.sh pricing",
    "test:db-security:int": "bash tooling/scripts/run-integration-tests.sh db-security",
    "test:lpms:int": "bash tooling/scripts/run-integration-tests.sh lpms",
    "test:lpms:e2e": "pnpm build:integration-deps && VITEST_MAX_WORKERS=2 pnpm --filter @pressly/http-verification exec vitest run test/cents && VITEST_MAX_WORKERS=1 pnpm --filter @pressly/flow-verification test:postgres && VITEST_MAX_WORKERS=2 pnpm exec turbo test --filter=@pressly/processor-browser-host --concurrency=2",
    "test:browser:e2e": "bash tooling/scripts/run-browser-e2e.sh",
    "test:browser:smoke": "bash tooling/scripts/run-browser-e2e.sh --grep @smoke",
    "test:browser:install": "playwright install chromium",
    "docker:lpms:build": "docker compose build api worker processor",
    "docker:production:smoke": "bash tooling/scripts/production-topology-smoke.sh",
    "test:int": "bash tooling/scripts/run-integration-tests.sh all",
    "stateworks:validate": "tsx stateworks/tooling/validate-network.ts",
    "stateworks:next": "tsx stateworks/tooling/next-batch.ts",
    "stateworks:verify": "tsx stateworks/tooling/verify.ts",
    "stateworks:memory:validate": "tsx stateworks/tooling/validate-memory.ts",
    "stateworks:memory:context": "tsx stateworks/tooling/build-context-pack.ts",
    "stateworks:memory:apply": "tsx stateworks/tooling/apply-memory-delta.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.2.5",
    "@playwright/test": "^1.55.1",
    "@pressly/errors": "workspace:*",
    "@pressly/experience-control": "workspace:*",
    "@pressly/experience-processor": "workspace:*",
    "@pressly/postgres": "workspace:*",
    "@pressly/pricing-system": "workspace:*",
    "@types/node": "^25.6.0",
    "dependency-cruiser": "18.2.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "otpauth": "^9.4.1",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "postgres": "^3.4.7",
    "tsx": "^4.23.11",
    "turbo": "^2.10.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  },
  "pnpm": {
    "overrides": {
      "@babel/core@<=7.29.0": "7.29.7",
      "body-parser@>=2.0.0 <2.3.0": "2.3.0",
      "brace-expansion@5.0.5": "5.0.9",
      "qs@>=6.11.1 <=6.15.1": "6.15.2",
      "typescript": "6.0.3",
      "undici@>=7.0.0 <7.29.0": "7.29.0",
      "ws@>=8.0.0 <8.21.0": "8.21.0",
      "zod": "4.3.6"
    }
  }
}

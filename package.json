{
  "name": "pressly",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:recursive": "node ./tooling/scripts/run-package-tests.mjs",
    "clean": "turbo clean",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "docker:web:build": "docker build -f apps/web/Dockerfile -t pressly-web:local -t ghcr.io/steven-rosales/pressly-web:local .",
    "docker:web:run": "docker run --rm -p 3000:3000 pressly-web:local",
    "docker:web:up": "docker compose up --build web",
    "docker:web:down": "docker compose down --remove-orphans",
    "docker:web:pull": "docker pull ghcr.io/steven-rosales/pressly-web:latest",
    "env:web:pull": "pnpm dlx vercel env pull apps/web/.env.local",
    "db:migrate": "pnpm -F @pressly/db migrate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.2.5",
    "@types/node": "^25.6.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "turbo": "^2.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "overrides": {
      "zod": "4.3.6"
    }
  }
}

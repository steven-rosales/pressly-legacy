{
  "extends": "../../packages/tsconfig/node.json",
  "compilerOptions": {
    "composite": false,
    "jsx": "react-jsx",
    "noEmit": true,
    "rootDir": "../..",
    "types": ["node", "vitest"],
    "paths": {
      "@pressly/codec": ["../../packages/codec/src/index.ts"],
      "@pressly/codec/node": ["../../packages/codec/src/node.ts"],
      "@pressly/codec/zod": ["../../packages/codec/src/zod.ts"],
      "@pressly/contracts/utc-iso": [
        "../../packages/contracts/src/utc-iso.contracts.ts"
      ],
      "@pressly/contracts/*": ["../../packages/contracts/src/*/index.ts"],
      "@pressly/db/schema/*": ["../../packages/db/src/schema/*.schema.ts"],
      "@pressly/db/*": ["../../packages/db/src/*.ts"],
      "@pressly/errors/*": ["../../packages/errors/src/*.ts"],
      "@pressly/http": ["../../packages/http/src/index.ts"],
      "@pressly/identity": ["../../modules/security/identity/src/public.ts"],
      "@pressly/kernel": ["../../packages/kernel/src/index.ts"],
      "@pressly/kernel/node": ["../../packages/kernel/src/node.ts"],
      "@pressly/money": ["../../packages/money/src/index.ts"],
      "@pressly/production": [
        "../../modules/business/production/src/public.ts"
      ],
      "@pressly/webhook-ingestion": [
        "../../modules/integration/webhook-ingestion/src/public.ts"
      ],
      "@pressly/time": ["../../packages/time/src/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["dist", "node_modules"]
}

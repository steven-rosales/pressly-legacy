{
  "name": "@pressly/cli",
  "private": true,
  "type": "module",
  "bin": {
    "pressly-admin": "./dist/main.js"
  },
  "scripts": {
    "build:workspace-deps": "pnpm --dir ../../packages/errors run build && pnpm --dir ../../packages/contracts run build && pnpm --dir ../../packages/auth run build && pnpm --dir ../../packages/db run build && pnpm --dir ../../packages/http run build && pnpm --dir ../../packages/presenters run build && pnpm --dir ../../modules/pricing run build",
    "dev": "pnpm run build:workspace-deps && tsx src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "tsx --test 'src/**/*.test.ts' 'src/**/*.spec.ts'",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@pressly/auth": "workspace:*",
    "@pressly/contracts": "workspace:*",
    "@pressly/db": "workspace:*",
    "@pressly/errors": "workspace:*",
    "@pressly/presenters": "workspace:*",
    "@pressly/pricing": "workspace:*",
    "dotenv": "^17.4.2",
    "ink": "^6.8.0",
    "react": "^19.2.6"
  },
  "devDependencies": {
    "@pressly/tsconfig": "workspace:*",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "tsx": "latest",
    "typescript": "latest"
  }
}

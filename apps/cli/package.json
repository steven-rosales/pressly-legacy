{
  "name": "@pressly/cli",
  "private": true,
  "type": "module",
  "bin": {
    "pressly-admin": "./dist/main.js"
  },
  "scripts": {
    "build:workspace-deps": "pnpm --dir ../.. exec turbo build --filter=@pressly/cli...",
    "dev": "pnpm run build:workspace-deps && tsx src/main.ts",
    "start": "node dist/main.js",
    "bootstrap:production": "pnpm run build:workspace-deps && pnpm --dir ../.. exec tsx apps/cli/src/commands/bootstrap-production.command.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src test --max-warnings=0",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@pressly/contracts": "workspace:*",
    "@pressly/db": "workspace:*",
    "@pressly/errors": "workspace:*",
    "@pressly/http": "workspace:*",
    "@pressly/kernel": "workspace:*",
    "@pressly/money": "workspace:*",
    "@pressly/production": "workspace:*",
    "@pressly/production-policy": "workspace:*",
    "@pressly/production-scheduling": "workspace:*",
    "@pressly/webhook-ingestion": "workspace:*",
    "dotenv": "^17.4.2",
    "ink": "^6.8.0",
    "react": "^19.2.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@pressly/tsconfig": "workspace:*",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "^4.1.5"
  }
}

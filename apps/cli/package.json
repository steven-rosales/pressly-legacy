{
  "name": "@pressly/cli",
  "private": true,
  "type": "module",
  "bin": {
    "pressly-admin": "./dist/main.js"
  },
  "scripts": {
    "build:workspace-deps": "pnpm --dir ../../packages/kernel run build && pnpm --dir ../../packages/time run build && pnpm --dir ../../packages/errors run build && pnpm --dir ../../packages/contracts run build && pnpm --dir ../../packages/money run build",
    "dev": "pnpm run build:workspace-deps && tsx src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src test --max-warnings=0",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@pressly/contracts": "workspace:*",
    "@pressly/errors": "workspace:*",
    "@pressly/kernel": "workspace:*",
    "@pressly/money": "workspace:*",
    "dotenv": "^17.4.2",
    "ink": "^6.8.0",
    "react": "^19.2.6"
  },
  "devDependencies": {
    "@pressly/tsconfig": "workspace:*",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "^4.1.5"
  }
}

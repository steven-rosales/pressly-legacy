{
  "extends": "../../packages/tsconfig/next.json",
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "incremental": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@/*": ["./src/*"],
      "@pressly/config": ["../../packages/config/dist/index"],
      "@pressly/errors": ["../../packages/errors/dist/index"],
      "@pressly/logging": ["../../packages/logging/dist/index"],
      "@pressly/metrics": ["../../packages/metrics/dist/index"]
    },
    "resolveJsonModule": true,
    "types": ["node", "vitest/globals", "@testing-library/jest-dom"]
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}

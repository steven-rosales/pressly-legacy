{
  "name": "@pressly/web",
  "private": true,
  "type": "module",
  "scripts": {
    "build:workspace-deps": "pnpm --dir ../../packages/errors run build && pnpm --dir ../../packages/config run build && pnpm --dir ../../packages/logging run build && pnpm --dir ../../packages/metrics run build",
    "dev": "pnpm run build:workspace-deps && next dev",
    "build": "pnpm run build:workspace-deps && next build",
    "typecheck": "tsc --noEmit",
    "seo:validate": "node scripts/validate-seo.mjs",
    "schema:validate": "node scripts/validate-schema.mjs",
    "lint": "echo \"lint pending: @pressly/web\"",
    "test": "echo \"test pending: @pressly/web\"",
    "clean": "rm -rf .next"
  },
  "devDependencies": {
    "@pressly/tsconfig": "workspace:*",
    "@tailwindcss/postcss": "^4.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "tailwindcss": "^4.2.4",
    "ts-jest": "^29.4.9",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@pressly/config": "workspace:*",
    "@pressly/errors": "workspace:*",
    "@pressly/logging": "workspace:*",
    "@pressly/metrics": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@sentry/nextjs": "^10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.11.0",
    "next": "^16.2.3",
    "posthog-js": "^1.372.3",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.73.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",

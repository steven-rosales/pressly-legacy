{
  "name": "@pressly/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "build:workspace-deps": "pnpm --dir ../.. exec turbo build --filter=@pressly/worker...",
    "dev": "pnpm run build:workspace-deps && tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src test vitest.config.ts --max-warnings=0",
    "test": "vitest run --exclude 'test/**/*.int.test.ts' --passWithNoTests",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@pressly/tsconfig": "workspace:*",
    "@types/node": "^25.6.0",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@pressly/config": "workspace:*",
    "@pressly/contracts": "workspace:*",
    "@pressly/db": "workspace:*",
    "@pressly/errors": "workspace:*",
    "@pressly/logging": "workspace:*",
    "@pressly/metrics": "workspace:*",
    "@pressly/orders": "workspace:*",
    "@pressly/production": "workspace:*",
    "@pressly/production-policy": "workspace:*",
    "@pressly/production-scheduling": "workspace:*",
    "@pressly/webhook-ingestion": "workspace:*",
    "@sentry/node": "^10.50.0",
    "dotenv": "^17.4.2",
    "zod": "^4.3.6"
  }
}

# Local API defaults. Copy to apps/api/.env.local for local development.
# Do not use these secrets outside local development.

NODE_ENV=development
SHUTDOWN_GRACE_PERIOD_MS=30000

API_HOST=0.0.0.0
API_PORT=4000
CORS_ORIGIN=http://localhost:3000

API_GLOBAL_RATE_LIMIT=300
API_GLOBAL_RATE_WINDOW_SECONDS=60
API_LOGIN_RATE_LIMIT=20
API_LOGIN_RATE_WINDOW_SECONDS=900

DATABASE_URL=postgres://pressly:pressly@localhost:55433/pressly
DATABASE_MAX_CONNECTIONS=10

AUTH_SECRET=local-dev-auth-secret
AUTH_SESSION_TTL_MINUTES=720
AUTH_SESSION_IDLE_TIMEOUT_MINUTES=60
AUTH_LOGIN_WINDOW_MINUTES=15
AUTH_LOGIN_MAX_FAILURES=8
AUTH_FRESH_SESSION_MAX_AGE_MINUTES=15
AUTH_MFA_CHALLENGE_TTL_MINUTES=5
# Base64 for 32 bytes: "0123456789abcdef0123456789abcdef".
AUTH_MFA_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
AUTH_MFA_ISSUER=Pressly

FEATURE_METRICS_ENABLED=false
FEATURE_JOBS_ENABLED=false

SENTRY_ENABLED=false
SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_DSN=https://public-key@example.ingest.sentry.io/project
# SENTRY_RELEASE=pressly-local

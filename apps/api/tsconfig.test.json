{
  "extends": "../../packages/tsconfig/node.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "rootDir": "../..",
    "types": ["node", "vitest"],
    "paths": {
      "@pressly/authorization": [
        "../../modules/security/authorization/src/public.ts"
      ],
      "@pressly/identity": ["../../modules/security/identity/src/public.ts"],
      "@pressly/auth/authentication": [
        "../../packages/auth/src/authentication/index.ts"
      ],
      "@pressly/auth/authorization": [
        "../../packages/auth/src/authorization/index.ts"
      ],
      "@pressly/auth/credentials": [
        "../../packages/auth/src/credentials/index.ts"
      ],
      "@pressly/config": ["../../packages/config/src/index.ts"],
      "@pressly/control-experience": [
        "../../modules/experience/control/src/public.ts"
      ],
      "@pressly/codec": ["../../packages/codec/src/index.ts"],
      "@pressly/codec/node": ["../../packages/codec/src/node.ts"],
      "@pressly/codec/zod": ["../../packages/codec/src/zod.ts"],
      "@pressly/contracts/utc-iso": [
        "../../packages/contracts/src/utc-iso.contracts.ts"
      ],
      "@pressly/contracts/*": ["../../packages/contracts/src/*/index.ts"],
      "@pressly/db/schema/*": ["../../packages/db/src/schema/*.schema.ts"],
      "@pressly/db/*": ["../../packages/db/src/*.ts"],
      "@pressly/errors/*": ["../../packages/errors/src/*.ts"],
      "@pressly/http": ["../../packages/http/src/index.ts"],
      "@pressly/http/express": ["../../packages/http/src/express/index.ts"],
      "@pressly/kernel": ["../../packages/kernel/src/index.ts"],
      "@pressly/kernel/node": ["../../packages/kernel/src/node.ts"],
      "@pressly/logging": ["../../packages/logging/src/index.ts"],
      "@pressly/observability": ["../../packages/observability/src/index.ts"],
      "@pressly/pricing": ["../../modules/business/pricing/src/public.ts"],
      "@pressly/processor-experience": [
        "../../modules/experience/processor/src/public.ts"
      ],
      "@pressly/production": [
        "../../modules/business/production/src/public.ts"
      ],
      "@pressly/production/testing": [
        "../../modules/business/production/test/support/memory-production-repositories.ts"
      ],
      "@pressly/time": ["../../packages/time/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts"],
  "exclude": ["dist", "node_modules"]
}

{
  "extends": "../../packages/tsconfig/node.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "rootDir": "../..",
    "types": ["node", "vitest"],
    "paths": {
      "@pressly/access-control": [
        "../../modules/policy/access-control/src/public.ts"
      ],
      "@pressly/auth-module": ["../../modules/business/auth/src/public.ts"],
      "@pressly/auth/authentication": [
        "../../packages/auth/src/authentication/index.ts"
      ],
      "@pressly/auth/authorization": [
        "../../packages/auth/src/authorization/index.ts"
      ],
      "@pressly/auth/credentials": [
        "../../packages/auth/src/credentials/index.ts"
      ],
      "@pressly/config": ["../../packages/config/src/index.ts"],
      "@pressly/contracts": ["../../packages/contracts/src/index.ts"],
      "@pressly/db": ["../../packages/db/src/index.ts"],
      "@pressly/errors": ["../../packages/errors/src/index.ts"],
      "@pressly/http": ["../../packages/http/src/index.ts"],
      "@pressly/http/express": ["../../packages/http/src/express/index.ts"],
      "@pressly/kernel": ["../../packages/kernel/src/index.ts"],
      "@pressly/logging": ["../../packages/logging/src/index.ts"],
      "@pressly/metrics": ["../../packages/metrics/src/index.ts"],
      "@pressly/pricing": ["../../modules/business/pricing/src/public.ts"],
      "@pressly/time": ["../../packages/time/src/index.ts"]
    }
  },
  "include": ["src/common/**/*.ts", "test/**/*.ts", "vitest.config.ts"],
  "exclude": ["dist", "node_modules"]
}

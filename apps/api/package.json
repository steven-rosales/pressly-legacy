{
  "name": "@pressly/api",
  "private": true,
  "type": "module",
  "scripts": {
    "build:workspace-deps": "pnpm --dir ../.. exec turbo build --filter=@pressly/api...",
    "dev": "pnpm run build:workspace-deps && tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm typecheck:test",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src test vitest.config.ts --max-warnings=0",
    "test": "vitest run",
    "docker:build": "docker build --target dev -f Dockerfile -t pressly-api:local ../..",
    "docker:build:runner": "docker build --target runner -f Dockerfile -t pressly-api:local ../..",
    "docker:up": "pnpm --dir ../.. docker:api:up",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@pressly/tsconfig": "workspace:*",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@pressly/access-control": "workspace:*",
    "@pressly/auth-module": "workspace:*",
    "@pressly/config": "workspace:*",
    "@pressly/contracts": "workspace:*",
    "@pressly/db": "workspace:*",
    "@pressly/errors": "workspace:*",
    "@pressly/http": "workspace:*",
    "@pressly/logging": "workspace:*",
    "@pressly/metrics": "workspace:*",
    "@pressly/orders": "workspace:*",
    "@pressly/pricing": "workspace:*",
    "@pressly/production": "workspace:*",
    "@pressly/production-policy": "workspace:*",
    "@pressly/production-scheduling": "workspace:*",
    "@pressly/webhook-ingestion": "workspace:*",
    "@pressly/users": "workspace:*",
    "@sentry/node": "^10.50.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "zod": "^4.3.6"
  }
}

{
  "name": "@pressly/postgres",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./advisory-lock": {
      "types": "./dist/advisory-lock.postgres.d.ts",
      "import": "./dist/advisory-lock.postgres.js",
      "default": "./dist/advisory-lock.postgres.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./health": {
      "types": "./dist/health.d.ts",
      "import": "./dist/health.js",
      "default": "./dist/health.js"
    },
    "./migration-ledger": {
      "types": "./dist/migration-ledger.d.ts",
      "import": "./dist/migration-ledger.js",
      "default": "./dist/migration-ledger.js"
    },
    "./migration-runner": {
      "types": "./dist/migration-runner.d.ts",
      "import": "./dist/migration-runner.js",
      "default": "./dist/migration-runner.js"
    },
    "./query": {
      "types": "./dist/query.d.ts",
      "import": "./dist/query.js",
      "default": "./dist/query.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./unit-of-work": {
      "types": "./dist/unit-of-work.d.ts",
      "import": "./dist/unit-of-work.js",
      "default": "./dist/unit-of-work.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src test vitest.config.ts vitest.postgres.config.ts --max-warnings=0",
    "test": "VITEST_MAX_WORKERS=2 vitest run --config vitest.config.ts",
    "test:postgres": "VITEST_MAX_WORKERS=1 vitest run --config vitest.postgres.config.ts --no-file-parallelism"
  },
  "dependencies": {
    "@pressly/cells": "workspace:*",
    "@pressly/errors": "workspace:*",
    "drizzle-orm": "^0.45.0",
    "pg": "^8.20.0",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "typescript": "6.0.3",
    "vitest": "^4.1.11"
  }
}

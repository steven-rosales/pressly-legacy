{
  "extends": "../../tooling/typescript/node.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "rootDir": "../..",
    "types": ["node", "vitest"],
    "paths": {
      "@pressly/codec": ["../../platform/codec/src/index.ts"],
      "@pressly/errors/*": ["../errors/src/*.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts"],
  "exclude": ["dist", "node_modules"],
  "references": [
    {
      "path": "../errors/tsconfig.json"
    }
  ]
}

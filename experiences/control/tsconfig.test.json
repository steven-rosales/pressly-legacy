{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "exactOptionalPropertyTypes": false,
    "noEmit": true,
    "rootDir": ".",
    "jsx": "react-jsx",
    "types": ["node", "vitest/globals", "@testing-library/jest-dom/vitest"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.json",
    "test/**/*.ts",
    "test/**/*.tsx",
    "vitest.config.ts"
  ],
  "references": [
    {
      "path": "../../platform/cells/tsconfig.json"
    },
    {
      "path": "../../platform/codec/tsconfig.json"
    },
    {
      "path": "../../platform/errors/tsconfig.json"
    },
    {
      "path": "../../platform/http/tsconfig.json"
    },
    {
      "path": "../../platform/testing/tsconfig.json"
    },
    {
      "path": "../../platform/time/tsconfig.json"
    },
    {
      "path": "../../systems/access/tsconfig.json"
    },
    {
      "path": "../../systems/customers/tsconfig.json"
    },
    {
      "path": "../../systems/ingress/tsconfig.json"
    },
    {
      "path": "../../systems/orders/tsconfig.json"
    },
    {
      "path": "../../systems/production/tsconfig.json"
    }
  ]
}

{
  "extends": "../../tooling/typescript/base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "rootDir": "src",
    "outDir": "dist",
    "paths": {
      "#customer/*": ["./src/web/*"]
    },
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.json"],
  "exclude": ["dist", "node_modules", "src/**/*.test.ts", "src/**/*.test.tsx"],
  "references": [
    {
      "path": "../../platform/cells/tsconfig.json"
    },
    {
      "path": "../../platform/errors/tsconfig.json"
    },
    {
      "path": "../../platform/logging/tsconfig.json"
    },
    {
      "path": "../../platform/observability/tsconfig.json"
    },
    {
      "path": "../../platform/testing/tsconfig.json"
    },
    {
      "path": "../../platform/time/tsconfig.json"
    },
    {
      "path": "../../systems/access/tsconfig.json"
    },
    {
      "path": "../../systems/pricing/tsconfig.json"
    }
  ]
}

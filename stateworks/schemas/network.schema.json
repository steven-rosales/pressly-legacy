{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trypressly.com/stateworks/network.schema.json",
  "title": "Stateworks Network",
  "type": "object",
  "required": ["work_id", "title", "goal", "tasks"],
  "properties": {
    "work_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["queued", "active", "done", "archived", "blocked"]
    },
    "goal": {
      "type": ["string", "array"],
      "items": { "type": "string" }
    },
    "invariants": {
      "type": "array",
      "items": { "type": "string" }
    },
    "max_repair_attempts": {
      "type": "integer",
      "minimum": 0,
      "default": 3
    },
    "stop_on": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "human_action_required",
          "destructive_change_required",
          "repeated_verifier_failure",
          "invariant_violation"
        ]
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "./task.schema.json"
      }
    }
  },
  "additionalProperties": true
}

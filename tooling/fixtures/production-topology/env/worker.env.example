# Synthetic local-only values. Never copy this file into a deployed environment.
NODE_ENV=production
DATABASE_URL=
FEATURE_JOBS_ENABLED=true
WORKER_POLL_INTERVAL_MS=250
WORKER_LEASE_MS=30000
WORKER_BATCH_SIZE=20
WORKER_MAX_ATTEMPTS=8
WORKER_RETRY_BASE_MS=250
WORKER_RETRY_MAX_MS=30000
WORKER_LOOP_RETRY_BASE_MS=250
WORKER_LOOP_RETRY_MAX_MS=5000
WORKER_HEARTBEAT_FILE=/tmp/pressly-worker-heartbeat
WORKER_HEARTBEAT_MAX_AGE_MS=15000
WORKER_METRIC_LOG_INTERVAL_MS=5000
SENTRY_ENABLED=true
SENTRY_DSN=http://offlinesmoke@127.0.0.1:9/1
SENTRY_RELEASE=pressly-offline-smoke
SENTRY_TRACES_SAMPLE_RATE=0

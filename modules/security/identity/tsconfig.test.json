{
  "extends": "../../../packages/tsconfig/node.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "rootDir": "../../..",
    "types": ["node", "vitest"],
    "paths": {
      "@pressly/auth/authentication": [
        "../../../packages/auth/src/authentication/index.ts"
      ],
      "@pressly/auth/authorization": [
        "../../../packages/auth/src/authorization/index.ts"
      ],
      "@pressly/auth/credentials": [
        "../../../packages/auth/src/credentials/index.ts"
      ],
      "@pressly/codec": ["../../../packages/codec/src/index.ts"],
      "@pressly/codec/zod": ["../../../packages/codec/src/zod.ts"],
      "@pressly/contracts/utc-iso": [
        "../../../packages/contracts/src/utc-iso.contracts.ts"
      ],
      "@pressly/contracts/*": ["../../../packages/contracts/src/*/index.ts"],
      "@pressly/db/schema/*": ["../../../packages/db/src/schema/*.schema.ts"],
      "@pressly/db/*": ["../../../packages/db/src/*.ts"],
      "@pressly/errors/*": ["../../../packages/errors/src/*.ts"],
      "@pressly/http": ["../../../packages/http/src/index.ts"],
      "@pressly/http/express": ["../../../packages/http/src/express/index.ts"],
      "@pressly/kernel": ["../../../packages/kernel/src/index.ts"],
      "@pressly/testkit": ["../../../packages/testkit/src/index.ts"],
      "@pressly/testkit/*": ["../../../packages/testkit/src/*.ts"],
      "@pressly/time": ["../../../packages/time/src/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "../../../packages/testkit/src/**/*.ts"
  ],
  "exclude": ["dist", "node_modules"]
}

{
  "name": "@pressly/production",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/public.js",
  "types": "./dist/public.d.ts",
  "exports": {
    ".": {
      "types": "./dist/public.d.ts",
      "import": "./dist/public.js",
      "default": "./dist/public.js"
    },
    "./testing": {
      "types": "./test/support/memory-production-repositories.ts",
      "import": "./test/support/memory-production-repositories.ts",
      "default": "./test/support/memory-production-repositories.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src test vitest.config.ts --max-warnings=0",
    "test": "vitest run --exclude 'test/**/*.int.test.ts'",
    "test:integration": "vitest run test/**/*.int.test.ts --no-file-parallelism",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@pressly/contracts": "workspace:*",
    "@pressly/db": "workspace:*",
    "@pressly/errors": "workspace:*",
    "@pressly/http": "workspace:*",
    "@pressly/kernel": "workspace:*",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@pressly/testkit": "workspace:*",
    "@pressly/tsconfig": "workspace:*",
    "@types/express": "^5.0.6",
    "typescript": "6.0.3",
    "vitest": "^4.1.5"
  }
}

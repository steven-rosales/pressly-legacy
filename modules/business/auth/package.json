{
  "name": "@pressly/auth-module",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/public.js",
  "types": "./dist/public.d.ts",
  "exports": {
    ".": {
      "types": "./dist/public.d.ts",
      "import": "./dist/public.js",
      "default": "./dist/public.js"
    }
  },
  "scripts": {
    "build:workspace-deps": "pnpm --dir ../../../packages/kernel run build && pnpm --dir ../../../packages/time run build && pnpm --dir ../../../packages/errors run build && pnpm --dir ../../../packages/auth run build && pnpm --dir ../../../packages/db run build",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "bootstrap:owner": "pnpm run build:workspace-deps && pnpm --dir ../../.. exec tsx modules/business/auth/src/adapters/bootstrap-owner/cli/bootstrap-owner.command.ts",
    "test": "vitest run --exclude 'test/**/*.int.test.ts'",
    "test:integration": "vitest run test/adapters/*.repo.int.test.ts --no-file-parallelism",
    "test:all": "pnpm test && pnpm test:integration",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@pressly/auth": "workspace:*",
    "@pressly/contracts": "workspace:*",
    "@pressly/db": "workspace:*",
    "@pressly/errors": "workspace:*",
    "@pressly/http": "workspace:*",
    "@pressly/kernel": "workspace:*",
    "@pressly/time": "workspace:*",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@pressly/testkit": "workspace:*",
    "@pressly/tsconfig": "workspace:*",
    "@types/express": "^5.0.6",
    "typescript": "latest",
    "vitest": "^4.1.5"
  }
}

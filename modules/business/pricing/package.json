{
  "name": "@pressly/pricing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/public.js",
  "types": "./dist/public.d.ts",
  "exports": {
    ".": {
      "types": "./dist/public.d.ts",
      "import": "./dist/public.js",
      "default": "./dist/public.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm run typecheck:test",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src test --max-warnings=0",
    "test": "VITEST_MAX_WORKERS=2 vitest run --exclude 'test/**/*.int.test.ts'",
    "test:integration": "vitest run test/integration --no-file-parallelism",
    "test:all": "pnpm test && pnpm test:integration",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@pressly/contracts": "workspace:*",
    "@pressly/db": "workspace:*",
    "@pressly/errors": "workspace:*",
    "@pressly/http": "workspace:*",
    "@pressly/kernel": "workspace:*",
    "@pressly/time": "workspace:*",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@pressly/testkit": "workspace:*",
    "@pressly/tsconfig": "workspace:*",
    "@types/express": "^5.0.6",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "^4.1.5"
  }
}

{
  "name": "@pressly/access-control",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/public.js",
  "types": "./dist/public.d.ts",
  "exports": {
    ".": {
      "types": "./dist/public.d.ts",
      "import": "./dist/public.js",
      "default": "./dist/public.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm run typecheck:test",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@pressly/auth": "workspace:*",
    "@pressly/contracts": "workspace:*",
    "@pressly/errors": "workspace:*",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@pressly/tsconfig": "workspace:*",
    "@types/express": "^5.0.6",
    "typescript": "latest",
    "vitest": "^4.1.5"
  }
}

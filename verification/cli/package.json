{
  "name": "@pressly/cli-verification",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "lint": "eslint test vitest.config.ts --max-warnings=0",
    "test": "VITEST_MAX_WORKERS=2 vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@pressly/access-system": "workspace:*",
    "@pressly/cells": "workspace:*",
    "@pressly/cli-host": "workspace:*",
    "@pressly/errors": "workspace:*",
    "@pressly/experience-control": "workspace:*",
    "@pressly/http": "workspace:*",
    "@pressly/ingress-system": "workspace:*",
    "@pressly/postgres": "workspace:*",
    "@pressly/production-system": "workspace:*",
    "@pressly/time": "workspace:*",
    "@pressly/topology": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  }
}

{
  "name": "@pressly/query-verification",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist",
    "lint": "eslint . --max-warnings=0",
    "test": "VITEST_MAX_WORKERS=2 vitest run --config vitest.config.ts --exclude '**/*.int.test.ts'",
    "test:postgres": "VITEST_MAX_WORKERS=1 vitest run --config vitest.config.ts --no-file-parallelism test/list-history-activity.conformance.int.test.ts test/list-history-plans.conformance.int.test.ts test/list-order-control.conformance.int.test.ts test/load-board.conformance.int.test.ts test/load-history-run.conformance.int.test.ts test/load-remaining-day-forecast.conformance.int.test.ts test/load-workspace.conformance.int.test.ts test/production-queries.conformance.int.test.ts test/preview-order-backlog.conformance.int.test.ts test/preview-order-route.conformance.int.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@pressly/access-system": "workspace:*",
    "@pressly/cells": "workspace:*",
    "@pressly/postgres": "workspace:*",
    "@pressly/production-system": "workspace:*",
    "@pressly/testkit": "workspace:*",
    "@pressly/topology": "workspace:*"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "^4.1.11"
  }
}

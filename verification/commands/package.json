{
  "name": "@pressly/command-verification",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test vitest.config.ts --max-warnings=0",
    "test": "VITEST_MAX_WORKERS=2 vitest run --exclude '**/*.int.test.ts'",
    "test:postgres": "VITEST_MAX_WORKERS=1 vitest run --config vitest.config.ts --no-file-parallelism test/advance-stage.conformance.int.test.ts test/set-order-priority.conformance.int.test.ts test/floor-cells.conformance.int.test.ts test/change-admission.conformance.int.test.ts test/record-order-intake.conformance.int.test.ts test/change-order-resolution.conformance.int.test.ts test/manage-resources.conformance.int.test.ts test/commit-order-backlog.conformance.int.test.ts test/commit-order-route.conformance.int.test.ts test/apply-fulfillment-demand.conformance.int.test.ts test/resolve-source-closed-fulfillment.conformance.int.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@pressly/access-system": "workspace:*",
    "@pressly/cells": "workspace:*",
    "@pressly/postgres": "workspace:*",
    "@pressly/production-system": "workspace:*",
    "@pressly/testkit": "workspace:*",
    "@pressly/time": "workspace:*",
    "@pressly/topology": "workspace:*"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "^4.1.11"
  }
}

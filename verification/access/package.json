{
  "name": "@pressly/access-verification",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "lint": "eslint src test vitest.config.ts --max-warnings=0",
    "test": "VITEST_MAX_WORKERS=2 vitest run --exclude '**/*.int.test.ts'",
    "test:postgres": "VITEST_MAX_WORKERS=1 vitest run --config vitest.config.ts --no-file-parallelism test/session-public.conformance.int.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@pressly/access-system": "workspace:*",
    "@pressly/cells": "workspace:*",
    "@pressly/postgres": "workspace:*",
    "@pressly/testkit": "workspace:*",
    "@pressly/time": "workspace:*",
    "@pressly/topology": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  }
}

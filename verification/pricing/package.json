{
  "name": "@pressly/pricing-verification",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/public.js",
  "types": "./dist/src/public.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/public.d.ts",
      "import": "./dist/src/public.js",
      "default": "./dist/src/public.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test vitest.config.ts --max-warnings=0",
    "test": "VITEST_MAX_WORKERS=2 vitest run --exclude 'test/**/*.int.test.ts'",
    "test:postgres": "VITEST_MAX_WORKERS=1 vitest run test/pricing.conformance.int.test.ts --config vitest.config.ts --no-file-parallelism"
  },
  "dependencies": {
    "@pressly/pricing-system": "workspace:*",
    "@pressly/postgres": "workspace:*",
    "@pressly/testkit": "workspace:*",
    "@pressly/topology": "workspace:*",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "typescript": "6.0.3",
    "vitest": "^4.1.11"
  }
}

# Generate AUTH_SECRET with: openssl rand -base64 48
# Generate AUTH_MFA_ENCRYPTION_KEY with: openssl rand -base64 32
# Use the restricted runtime database role once Queue 2 is applied.

NODE_ENV=production
LOG_LEVEL=info
SHUTDOWN_GRACE_PERIOD_MS=30000

API_HOST=0.0.0.0
API_PORT=4000
CORS_ORIGIN=https://trypressly.com
API_GLOBAL_RATE_LIMIT=300
API_GLOBAL_RATE_WINDOW_SECONDS=60
API_LOGIN_RATE_LIMIT=20
API_LOGIN_RATE_WINDOW_SECONDS=900

DATABASE_URL=postgres://pressly_runtime:CHANGE_ME_RUNTIME_PASSWORD@postgres:5432/pressly
DATABASE_MAX_CONNECTIONS=10

AUTH_SECRET=CHANGE_ME_AUTH_SECRET
AUTH_SESSION_TTL_MINUTES=720
AUTH_SESSION_IDLE_TIMEOUT_MINUTES=60
AUTH_LOGIN_WINDOW_MINUTES=15
AUTH_LOGIN_MAX_FAILURES=8
AUTH_FRESH_SESSION_MAX_AGE_MINUTES=15
AUTH_MFA_CHALLENGE_TTL_MINUTES=5
AUTH_MFA_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_BASE64_KEY
AUTH_MFA_ISSUER=Pressly

FEATURE_METRICS_ENABLED=false
FEATURE_JOBS_ENABLED=false

SENTRY_ENABLED=true
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_DSN=CHANGE_ME_SENTRY_DSN
# SENTRY_RELEASE=pressly-production

# Generate AUTH_SECRET with: openssl rand -base64 48
# Generate AUTH_MFA_ENCRYPTION_KEY with: openssl rand -base64 32
# Generate PROCESSOR_CSRF_SECRET with: openssl rand -base64 48
# If using hmac mode, generate CENTS_WEBHOOK_HMAC_CURRENT_KEY with:
# openssl rand -base64 48
# Use the restricted runtime database role once Queue 2 is applied.

NODE_ENV=production
SHUTDOWN_GRACE_PERIOD_MS=30000

API_HOST=0.0.0.0
API_PORT=4000
CORS_ORIGIN=https://trypressly.com
API_GLOBAL_RATE_LIMIT=300
API_GLOBAL_RATE_WINDOW_SECONDS=60
API_LOGIN_RATE_LIMIT=20
API_LOGIN_RATE_WINDOW_SECONDS=900

DATABASE_URL=postgres://pressly_runtime:CHANGE_ME_RUNTIME_PASSWORD@postgres:5432/pressly
DATABASE_MAX_CONNECTIONS=10

AUTH_SECRET=CHANGE_ME_AUTH_SECRET
AUTH_SESSION_TTL_MINUTES=43200
AUTH_SESSION_IDLE_TIMEOUT_MINUTES=10080
AUTH_LOGIN_WINDOW_MINUTES=15
AUTH_LOGIN_MAX_FAILURES=8
AUTH_FRESH_SESSION_MAX_AGE_MINUTES=15
AUTH_MFA_CHALLENGE_TTL_MINUTES=5
AUTH_MFA_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_BASE64_KEY
AUTH_MFA_ISSUER=Pressly

PROCESSOR_ORIGIN=https://processor.trypressly.com
PROCESSOR_CSRF_SECRET=CHANGE_ME_WITH_AT_LEAST_32_BYTES_PROCESSOR_CSRF_SECRET

# Temporary compatibility mode for Cents' documented unsigned JSON webhook.
# Change to hmac and configure the keys below if Cents adds signing support.
CENTS_WEBHOOK_AUTH_MODE=unsigned
# CENTS_WEBHOOK_HMAC_CURRENT_KEY=CHANGE_ME_WITH_AT_LEAST_32_BYTES_CENTS_HMAC_KEY
# CENTS_WEBHOOK_HMAC_PREVIOUS_KEY=CHANGE_ME_WITH_AT_LEAST_32_BYTES_PREVIOUS_CENTS_HMAC_KEY
CENTS_WEBHOOK_CLOCK_WINDOW_SECONDS=300

FEATURE_METRICS_ENABLED=true
FEATURE_JOBS_ENABLED=false

SENTRY_ENABLED=true
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_DSN=CHANGE_ME_SENTRY_DSN
# SENTRY_RELEASE is injected from the validated deployment source SHA.

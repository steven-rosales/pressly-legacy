# Use the restricted runtime database role. Never place the Cents HMAC key in
# the worker environment; signature verification belongs to API ingress.
NODE_ENV=production
DATABASE_URL=postgres://pressly_runtime:CHANGE_ME_RUNTIME_PASSWORD@postgres:5432/pressly
FEATURE_JOBS_ENABLED=true
WORKER_POLL_INTERVAL_MS=1000
WORKER_LEASE_MS=30000
WORKER_BATCH_SIZE=20
WORKER_MAX_ATTEMPTS=8
WORKER_RETRY_BASE_MS=1000
WORKER_RETRY_MAX_MS=300000
WORKER_LOOP_RETRY_BASE_MS=1000
WORKER_LOOP_RETRY_MAX_MS=30000
WORKER_HEARTBEAT_FILE=/tmp/pressly-worker-heartbeat
WORKER_HEARTBEAT_MAX_AGE_MS=90000
WORKER_METRIC_LOG_INTERVAL_MS=60000
SENTRY_ENABLED=true
SENTRY_DSN=CHANGE_ME_SENTRY_DSN
# SENTRY_RELEASE is injected from the validated deployment source SHA.
SENTRY_TRACES_SAMPLE_RATE=0.1

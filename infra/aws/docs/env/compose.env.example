# Copy all files in this directory to /opt/pressly/env without the .example suffix.
# Lock every file down with: chmod 600 /opt/pressly/env/*.env
# This file contains Compose interpolation values, not runtime secrets.

# Deploy replaces these examples with the four digest references from one
# successful main-branch release manifest.
PRESSLY_API_IMAGE=ghcr.io/example/pressly/api@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
PRESSLY_WEB_IMAGE=ghcr.io/example/pressly/web@sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
PRESSLY_WORKER_IMAGE=ghcr.io/example/pressly/worker@sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
PRESSLY_PROCESSOR_IMAGE=ghcr.io/example/pressly/processor@sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd

# deploy.sh overrides this with the validated target commit. The example keeps
# direct `docker compose config` checks deterministic.
PRESSLY_RELEASE_SHA=eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee

API_BASE_URL=https://api.trypressly.com
NEXT_PUBLIC_API_BASE_URL=https://api.trypressly.com
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=

# Copy this file to /opt/pressly/.env.production on the Lightsail instance.
# Keep the real file off git and locked down with: chmod 600 /opt/pressly/.env.production
# Generate AUTH_SECRET with: openssl rand -base64 48
# Generate POSTGRES_PASSWORD with: openssl rand -hex 32

# Runtime
NODE_ENV=production
LOG_LEVEL=info
SHUTDOWN_GRACE_PERIOD_MS=30000

# API
API_HOST=0.0.0.0
API_PORT=4000
CORS_ORIGIN=https://trypressly.com

# Database
# POSTGRES_PASSWORD and the password inside DATABASE_URL must match.
POSTGRES_DB=pressly
POSTGRES_USER=pressly
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
DATABASE_URL=postgres://pressly:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/pressly
DATABASE_MAX_CONNECTIONS=10

# Auth
AUTH_SECRET=CHANGE_ME_AUTH_SECRET
AUTH_SESSION_TTL_MINUTES=720
AUTH_LOGIN_WINDOW_MINUTES=15
AUTH_LOGIN_MAX_FAILURES=8
AUTH_FRESH_SESSION_MAX_AGE_MINUTES=15

# Feature flags
FEATURE_METRICS_ENABLED=false
FEATURE_JOBS_ENABLED=false

# API observability
SENTRY_ENABLED=false
SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_RELEASE=pressly-production

POSTHOG_ENABLED=false
POSTHOG_HOST=https://us.i.posthog.com
# POSTHOG_PROJECT_API_KEY=CHANGE_ME_POSTHOG_PROJECT_API_KEY

# Web
HOSTNAME=0.0.0.0
PORT=3000
API_BASE_URL=https://api.trypressly.com
NEXT_PUBLIC_API_BASE_URL=https://api.trypressly.com
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Caddy domains
# These domains must point at the Lightsail static IP before the default deploy
# health checks can pass.
PRESSLY_WEB_DOMAIN=trypressly.com
PRESSLY_API_DOMAIN=api.trypressly.com

# One-time owner bootstrap.
# Prefer passing these with docker compose run -e instead of keeping them here.
# PRESSLY_BOOTSTRAP_OWNER_EMAIL=owner@example.com
# PRESSLY_BOOTSTRAP_OWNER_CONFIRM=bootstrap-first-owner
# PRESSLY_DEBUG_BOOTSTRAP_OWNER=1

# Deployment script overrides.
# Usually leave these unset unless the server layout changes.
# PRESSLY_APP_ROOT=/opt/pressly
# PRESSLY_REPO_DIR=/opt/pressly/repo
# PRESSLY_ENV_FILE=/opt/pressly/.env.production
# PRESSLY_COMPOSE_FILE=/opt/pressly/repo/infra/aws/lightsail/docker-compose.production.yml
# PRESSLY_API_HEALTH_URL=https://api.trypressly.com/health/ready
# PRESSLY_WEB_HEALTH_URL=https://trypressly.com/health

# Backup script overrides.
# Usually set PRESSLY_BACKUP_S3_URI in cron or the backup command, not here.
# PRESSLY_BACKUP_DIR=/opt/pressly/backups/postgres
# PRESSLY_BACKUP_PASSPHRASE_FILE=/opt/pressly/backup-passphrase.txt
# PRESSLY_BACKUP_RETENTION_DAYS=14
# PRESSLY_BACKUP_S3_URI=s3://your-pressly-backups/postgres

# Local/admin CLI only. Not needed by the production containers.
# PRESSLY_API_URL=https://api.trypressly.com

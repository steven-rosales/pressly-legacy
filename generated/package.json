{
  "name": "@pressly/generated",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./cli-catalog": {
      "types": "./dist/cli-catalog.d.ts",
      "import": "./dist/cli-catalog.js",
      "default": "./dist/cli-catalog.js"
    },
    "./architecture-map": {
      "types": "./dist/architecture-map.d.ts",
      "import": "./dist/architecture-map.js",
      "default": "./dist/architecture-map.js"
    },
    "./clients/control": {
      "types": "./dist/clients/control.d.ts",
      "import": "./dist/clients/control.js",
      "default": "./dist/clients/control.js"
    },
    "./clients/customer": {
      "types": "./dist/clients/customer.d.ts",
      "import": "./dist/clients/customer.js",
      "default": "./dist/clients/customer.js"
    },
    "./clients/processor": {
      "types": "./dist/clients/processor.d.ts",
      "import": "./dist/clients/processor.js",
      "default": "./dist/clients/processor.js"
    },
    "./event-stream-catalog": {
      "types": "./dist/event-stream-catalog.d.ts",
      "import": "./dist/event-stream-catalog.js",
      "default": "./dist/event-stream-catalog.js"
    },
    "./http-catalog": {
      "types": "./dist/http-catalog.d.ts",
      "import": "./dist/http-catalog.js",
      "default": "./dist/http-catalog.js"
    },
    "./job-catalog": {
      "types": "./dist/job-catalog.d.ts",
      "import": "./dist/job-catalog.js",
      "default": "./dist/job-catalog.js"
    },
    "./observability-catalog": {
      "types": "./dist/observability-catalog.d.ts",
      "import": "./dist/observability-catalog.js",
      "default": "./dist/observability-catalog.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "lint": "eslint . --max-warnings=0",
    "test": "VITEST_MAX_WORKERS=2 vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@pressly/access-system": "workspace:*",
    "@pressly/cells": "workspace:*",
    "@pressly/customers-system": "workspace:*",
    "@pressly/experience-control": "workspace:*",
    "@pressly/experience-customer": "workspace:*",
    "@pressly/experience-processor": "workspace:*",
    "@pressly/ingress-system": "workspace:*",
    "@pressly/orders-system": "workspace:*",
    "@pressly/pricing-system": "workspace:*",
    "@pressly/production-system": "workspace:*"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "^4.1.11"
  }
}
